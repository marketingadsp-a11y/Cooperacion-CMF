# ==============================================================================
# VARIABLES DE ENTORNO PARA VERCEL (SEPARACIÓN POR EMPRESA)
# ==============================================================================
# En Vercel: Ve a tu Proyecto -> Settings -> Environment Variables.
# Para cada empresa distinta, puedes crear un proyecto separado en Vercel apuntando
# a este mismo repositorio de GitHub y definir sus propias variables de entorno.

# ------------------------------------------------------------------------------
# 1. Configuración de Firebase (Base de datos y Auth de la Empresa)
# Obtenidos en Firebase Console -> Configuración del Proyecto -> General -> Tus apps (Web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mi-empresa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mi-empresa-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mi-empresa-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK (Opcional - para operaciones de servidor)
# Llave privada en JSON generada en Firebase Console -> Cuentas de servicio
# Pega todo el JSON en una sola línea o entre comillas
# ------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=

# ------------------------------------------------------------------------------
# 3. Inteligencia Artificial (Google Gemini / Genkit)
# Obtenida en Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GOOGLE_GENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Alojamiento de Comprobantes de Gastos y Logotipos (ImgBB)
# Obtenida gratis en https://api.imgbb.com/
# ------------------------------------------------------------------------------
NEXT_PUBLIC_IMGBB_API_KEY=

# ------------------------------------------------------------------------------
# 5. Personalización y Marca de la Empresa (Opcional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Cooperación
NEXT_PUBLIC_COMPANY_NAME=CMF
NEXT_PUBLIC_PWA_LOGO_URL=https://i.ibb.co/JWfQGf4d/logo-coperacion-cmf.jpg
